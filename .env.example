# ============================================================
# 电商AI视频工作流 · 环境变量模板
# 用法：复制本文件为 .env，填入真实密钥。.env 不要提交到版本库。
# ============================================================

# ---------- 1. 视觉识别 API（阶段 A1，必配；不配则走人工模式） ----------
# 默认 Agnes 2.5 Flash（多模态，OpenAI 兼容；本地图自动转 base64，无需公网 URL）
# 换其他多模态模型（GPT-4o/Gemini/Claude）改 BASE/MODEL 即可
VISION_API_KEY=
VISION_API_BASE=https://apihub.agnes-ai.com/v1
VISION_MODEL=agnes-2.5-flash

# ---------- 1.5 提示词生成 LLM（AI 介入写提示词；缺省复用 VISION 配置） ----------
TEXT_LLM_API_KEY=
TEXT_LLM_API_BASE=
TEXT_LLM_MODEL=
# 未设置时默认读取 VISION_API_KEY/VISION_MODEL

# ---------- 2. 视频生成模型（阶段 A2，开放接入；默认 Seedance 2.0） ----------
# 当前选用哪个视频模型 provider（必填；缺省 = seedance-2.0）
VIDEO_PROVIDER=agnes-video

# 键名规则：{PROVIDER大写}_API_KEY（provider 名规范化映射，如 seedance-2.0→SEEDANCE_API_KEY）；
# 通用兜底 VIDEO_API_KEY / IMAGE_API_KEY。各 provider 前缀见下方 2.0~2.7 小节。

# 2.0 agnes-video / agnes（与 VISION 同供应商；VIDEO_PROVIDER=agnes-video 时用下面这组键）
AGNES_API_KEY=
AGNES_API_BASE=
AGNES_MODEL=agnes-video-v2.0

# 2.1 Seedance 2.0（默认推荐：一致性强化 + 中文原生）
SEEDANCE_API_KEY=
SEEDANCE_API_BASE=
SEEDANCE_MODEL=seedance-2.0

# 2.2 Seedance 2.5（进阶：30s / 30图参考 / 时间戳编辑）
SEEDANCE25_API_KEY=
SEEDANCE25_API_BASE=
SEEDANCE25_MODEL=seedance-2.5

# 2.3 可灵 Kling
KLING_API_KEY=
KLING_API_BASE=
KLING_MODEL=kling

# 2.4 即梦（Seedance 同源）
JIMENG_API_KEY=
JIMENG_API_BASE=
JIMENG_MODEL=jimeng

# 2.5 Runway
RUNWAY_API_KEY=
RUNWAY_API_BASE=
RUNWAY_MODEL=gen-4

# 2.6 Vidu
VIDU_API_KEY=
VIDU_API_BASE=
VIDU_MODEL=vidu

# 2.7 自定义接入（任意 OpenAI 兼容接口）
# 注意：键名按 config.py 规范化映射规则 {PROVIDER大写}_API_KEY（如 seedance-2.0→SEEDANCE_API_KEY），
# 即 custom → CUSTOM_API_KEY（不是 CUSTOM_VIDEO_API_KEY）；通用兜底 VIDEO_API_KEY / IMAGE_API_KEY
CUSTOM_API_KEY=
CUSTOM_API_BASE=
CUSTOM_MODEL=

# ---------- 2.8 图片生成（合成首帧/概念图，开放接入；默认 custom） ----------
# 用途：视频模型不支持多参考图时，把「商品+模特/场景」合成一张首帧再图生视频；
#       以及 C 档无参考图时生成样衣概念图。不绑厂商，任意兼容接口可接。
# 注意：IMAGE_PROVIDER=custom-image / agnes-image 时键前缀规范化为 IMAGE（即直接走 IMAGE_API_KEY 族，
# 与通用兜底 IMAGE_API_KEY 一致）；其他 provider 名按 {PROVIDER大写}_API_KEY 规则
IMAGE_PROVIDER=custom-image
IMAGE_API_KEY=
IMAGE_API_BASE=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024

# ---------- 3. 可选：代理 / 超时 / 重试 ----------
HTTP_PROXY=
HTTPS_PROXY=
API_TIMEOUT_SECONDS=300
API_MAX_RETRIES=1
API_RETRY_INTERVAL_SECONDS=5
# 429 限流专属退避重试次数（30s 起指数退避，上限 300s；尊重 Retry-After）
API_429_MAX_RETRIES=3
# 生成单元规划：单条视频提交时长上限（秒）；实际生效 = min(该值, 模型 duration_max)
# 策略由 plan-units --strategy 决定（per-shot=一镜一提交 / merge=合并提交+超限AI切分）
UNIT_MAX_SECONDS=10

# ---------- 4. 项目路径 ----------
# 知识库根目录（缺省 = 本文件同级的 knowledge/）
KNOWLEDGE_DIR=
# 生成产物目录（视频/分镜JSON/确认单）
OUTPUT_DIR=./output
